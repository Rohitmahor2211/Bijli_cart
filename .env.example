# BijliCart local development configuration — copy to .env and replace values as needed.
# Never commit .env or real credentials.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Required only for the intentionally destructive local demo seed command.
ALLOW_DESTRUCTIVE_SEED=false

# Use a separate database for tests. Tests refuse to run against a non-test URI.
MONGO_URI=mongodb+srv://rohitmahor022_db_user:O4W9ewXY7VJAoiVZ@chat-application.frecjpr.mongodb.net/?appName=bijlicart_test
MONGO_TEST_URI=mongodb+srv://rohitmahor022_db_user:O4W9ewXY7VJAoiVZ@chat-application.frecjpr.mongodb.net/?appName=bijlicart_test

# Use distinct, long random values in every deployed environment.
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
PLATFORM_ADMIN_REGISTRATION_KEY=replace_with_a_long_random_one_time_setup_key

# One-time platform-admin bootstrap only. Set temporarily, run
# `npm run bootstrap:platform-admin`, then remove these values from .env.
PLATFORM_ADMIN_BOOTSTRAP_NAME=Platform Administrator
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_unique_12_plus_character_password

# OTP (mock is permitted only outside production)
SMS_PROVIDER=twilio
SMS_API_KEY=replace_with_fast2sms_api_key
SMS_SENDER_ID=BIJLI

TWILIO_ACCOUNT_SID=replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_PHONE_NUMBER=replace_with_twilio_phone_number

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
# This setting exists for automated tests only. Keep false in local development.
OTP_EXPOSE_CODE_FOR_TESTS=false

# Cloudinary uses a local mock when the cloud name is demo_cloud.
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
CLOUDINARY_UPLOAD_TIMEOUT_MS=60000

# Payments — keep mock until Razorpay sandbox/live onboarding is ready.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=replace_with_razorpay_test_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_when_razorpay_webhook_is_configured
RAZORPAYX_WEBHOOK_SECRET=replace_when_razorpayx_webhook_is_configured
PLATFORM_COMMISSION_PERCENT=10
# Customer payment is held for exactly three days before automatic payout.
SETTLEMENT_HOLD_DAYS=3
AUTO_PAYOUT_ENABLED=false
# RazorpayX virtual account number used to send seller payouts. Required for live automatic payouts.
RAZORPAYX_ACCOUNT_NUMBER=replace_with_razorpayx_account_number

# AES-256-GCM key used only by the backend to encrypt seller bank account numbers.
# Generate a unique 64-character hexadecimal value for every real environment.
BANK_DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Shipping - Shiprocket API user credentials (not the normal dashboard login).
SHIPPING_PROVIDER=shiprocket
SHIPROCKET_EMAIL=replace_with_shiprocket_api_email
SHIPROCKET_PASSWORD=replace_with_shiprocket_api_password
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPPING_DEFAULT_WEIGHT_KG=0.5
SHIPPING_DEFAULT_LENGTH_CM=20
SHIPPING_DEFAULT_BREADTH_CM=15
SHIPPING_DEFAULT_HEIGHT_CM=10


PLATFORM_ADMIN_REGISTRATION_KEY=replace_with_a_long_random_one_time_setup_key